# Email via Nodemailer is currently disabled in code. Submissions are saved locally only
# (see server/contact-storage.js) when using npm run dev + contact server.
# Optional if you re-enable SMTP later:
# EMAIL_HOST= EMAIL_PORT=587 EMAIL_USER= EMAIL_PASS= EMAIL_TO=
CONTACT_SERVER_PORT=8787

# Same secret on server and client (dashboard) to list saved contact submissions
CONTACT_ADMIN_KEY=change-this-to-a-long-random-string
VITE_CONTACT_ADMIN_KEY=change-this-to-a-long-random-string
